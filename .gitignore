**/settings.env
**/.env*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
data/

# Test and lint caches
.hypothesis/
.pytest_cache/
.ruff_cache/
*.zip

# Documentation build output
/site/

# Local agent state
**/.omc/
**/.omx/
.agents/
.claude/
.aws/
.codex/
.kiro/

# Git worktrees created for isolated task branches. Never commit these: git records a
# live worktree as a gitlink (mode 160000), which looks like a stray submodule.
.worktrees/

# uv is not this project's dependency workflow (pip + pyproject.toml / Docker resolve deps).
# Do not commit a uv lockfile: it would be a second, unused dependency resolution.
uv.lock
