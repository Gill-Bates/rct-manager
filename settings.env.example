# rct-manager start parameters. Copy to settings.env.
# Devices, authentication, API tokens, logging and export are managed in the admin GUI
# and stored encrypted in data/rct.db. See docs/getting-started/configuration.md.

# Encrypts data/rct.db; changing it makes the database unreadable.
# openssl rand -base64 32
HMAC_SECRET=

# Address and port for the first start; afterwards the values saved in the GUI apply.
BIND_ADDRESS=127.0.0.1
BIND_PORT=8080

# Explicit consent for a non-loopback listener. Does not provide TLS.
# Compose sets this while publishing the host port on 127.0.0.1.
ALLOW_NON_LOOPBACK_BIND=false

# Optional: location of the admin database.
# ADMIN_DB_PATH=data/rct.db
